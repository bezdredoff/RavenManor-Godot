extends SceneTree
## VNS5-05B first slice: line-bound micro-FX draft and editor preview only.
## Must preserve existing scene-wide FX, immutable Raven source and runtime state.
const Store = preload("res://addons/vn_studio/editor/raven_story_store.gd")
const StageFx = preload("res://addons/vn_studio/model/stage_fx_store.gd")
const StageV2 = preload("res://addons/vn_studio/model/stage_v2_store.gd")
const Designer = preload("res://addons/vn_studio/editor/raven_stage_designer.gd")

func _initialize() -> void:
	call_deferred("_run")


func _run() -> void:
	var root_path: String = ProjectSettings.globalize_path("res://")
	var source_file: String = root_path.path_join(Store.RELATIVE)
	var staging_file: String = root_path.path_join(Store.STAGING)
	var cast_file: String = root_path.path_join(Store.CAST)
	var source_sha: String = FileAccess.get_sha256(source_file)
	var staging_sha: String = FileAccess.get_sha256(staging_file)
	var cast_sha: String = FileAccess.get_sha256(cast_file)
	var project: Dictionary = Store.open_project(root_path)
	assert(project.get("ok", false), str(project.get("error", "")))
	var scene_id: String = str(project["scenes"][0]["sceneId"])
	var lines: Array = Store.line_ids(project, scene_id)
	assert(lines.size() >= 2)
	var first: String = str(lines[0])
	var second: String = str(lines[1])
	var draft: Dictionary = Store.fresh(project)
	var stage: Dictionary = Store.effective_stage(project, draft, scene_id)
	var v2: Dictionary = StageV2.fresh(scene_id)
	var fx: Dictionary = StageFx.fresh(scene_id)
	fx = StageFx.new_cue(fx, "background", "background")
	fx["cues"][0]["effect"] = "pulse"
	fx["cues"][0]["durationMs"] = 1400
	assert(not fx["cues"][0].has("lineId"), "Legacy stage-wide cues remain stage-wide")
	assert(StageFx.validate(stage, v2, fx).is_empty(), "Legacy FX must load without line catalog")
	fx = StageFx.new_cue(fx, "background", "background", second)
	fx["cues"][1]["effect"] = "fade_out"
	fx["cues"][1]["intensity"] = 1.0
	assert(StageFx.validate(stage, v2, fx, lines).is_empty())
	assert(StageFx.visible_for_line(fx["cues"][0], first))
	assert(StageFx.visible_for_line(fx["cues"][0], second))
	assert(not StageFx.visible_for_line(fx["cues"][1], first))
	assert(StageFx.visible_for_line(fx["cues"][1], second))
	assert(not StageFx.visible_for_line(fx["cues"][1], ""))
	var invalid: Dictionary = fx.duplicate(true)
	invalid["cues"][1]["lineId"] = "RM-BEAT-NOPE-L001"
	assert(not StageFx.validate(stage, v2, invalid, lines).is_empty(), "Reject unknown/cross-scene line")
	invalid = fx.duplicate(true)
	invalid["cues"][1]["lineId"] = ""
	assert(not StageFx.validate(stage, v2, invalid, lines).is_empty(), "Reject empty lineId")
	invalid = fx.duplicate(true)
	invalid["cues"][1]["lineId"] = 123
	assert(not StageFx.validate(stage, v2, invalid, lines).is_empty(), "Reject non-string lineId")
	assert(not StageFx.validate(stage, v2, fx).is_empty(), "Unknown line catalog must fail closed")
	assert(Store.set_stage_fx(project, draft, fx).is_empty())
	assert(Store.validate(project, draft).is_empty())
	assert(StageFx.effective(draft, scene_id) == fx)
	invalid = draft.duplicate(true)
	invalid["stageFxPatches"][scene_id]["cues"][1]["lineId"] = "RM-BEAT-00-02-L001"
	assert(not Store.validate(project, invalid).is_empty(), "Reject another scene's real lineId")
	assert(not Store.export_stage_candidate(project, draft).get("ok", false))
	assert(not Store.export_v2_candidate(project, draft).get("ok", false))
	var review: Dictionary = Store.export_fx_candidate(project, draft)
	assert(review.get("ok", false), str(review.get("error", "")))
	var review_text: String = FileAccess.get_file_as_string(str(review["path"]))
	assert(review_text.contains(second), "Review export must retain line anchors")
	assert(review_text.contains('"runtimeApplied": false'), "Review remains editor-only")
	assert(not Store.export_fx_candidate(project, draft).get("ok", false), "No overwrite")
	var designer := Designer.new()
	root.add_child(designer)
	designer.set_scene(project, draft, scene_id)
	designer.set_selected_line(first)
	designer._on_fx_scrub(700.0)
	assert(is_equal_approx(designer._bg_image.modulate.a, 1.0), "Line 1 excludes line 2 fade")
	assert(designer._bg_image.scale.x > 1.0, "Stage-wide pulse plays on line 1")
	designer.set_selected_line(second)
	designer._on_fx_scrub(700.0)
	assert(designer._bg_image.modulate.a < 1.0, "Line 2 activates line 2 fade")
	designer._on_fx_add()
	assert(designer._fx_data["cues"].size() == 3)
	assert(designer._fx_data["cues"][2]["lineId"] == second, "New FX binds current selected line")
	designer._on_fx_undo()
	assert(designer._fx_data["cues"].size() == 2)
	designer._on_fx_stop()
	designer.queue_free()
	assert(FileAccess.get_sha256(source_file) == source_sha)
	assert(FileAccess.get_sha256(staging_file) == staging_sha)
	assert(FileAccess.get_sha256(cast_file) == cast_sha)
	print("Raven VN Studio VNS5-05B line-bound FX authoring smoke passed")
	quit()
