extends SceneTree
## Owner-reported MAP-EDIT-03A UI layout and invisible geometry restrictions.
## Runs in a real Godot 4.7.2 Control tree; no production edits.
const Routes = preload("res://addons/room_builder_routes/route_document.gd")
const View = preload("res://addons/room_builder_routes/route_editor_view.gd")
const Adapter = preload("res://scripts/raven/first_floor_integrated_draft_adapter.gd")
const Preview = preload("res://addons/room_builder_routes/route_preview_source.gd")
const PROJECT := "res://assets/raven/map/qa/drafts/hall_routes_draft.v1.json"
const SOURCE := "res://assets/raven/map/qa/first_floor_hall_pilot.v1.json"
const CANONICAL := "res://data/raven/manor_greybox_graph.json"
const TEMP := "user://room_builder_routes/map_edit_03a_constraints_smoke.json"


func _initialize() -> void:
	call_deferred("_run")


func _run() -> void:
	var source_before := FileAccess.get_file_as_string(SOURCE)
	var project_before := FileAccess.get_file_as_string(PROJECT)
	var canonical_before := FileAccess.get_file_as_string(CANONICAL)
	assert(not source_before.is_empty() and not project_before.is_empty() and not canonical_before.is_empty())
	var loaded := Routes.load_draft(PROJECT)
	assert(loaded.get("ok", false), str(loaded.get("error", "")))
	var original: Dictionary = loaded["document"]
	assert(original["walkablePolygons"].size() == 5)
	assert(original["noGoPolygons"].size() == 10)
	assert(original["blockedCells"].is_empty())
	var outside: Dictionary = Routes.restriction_at(Vector2(100, 100), original)
	assert(outside["kind"] == "outside-walkable" and str(outside["reason"]).contains("WALKABLE"))
	var nogo: Dictionary = Routes.restriction_at(Vector2(840, 580), original)
	assert(nogo["kind"] == "no-go" and str(nogo["id"]).contains("TEA-TABLE"))
	assert(Routes.restriction_at(Vector2(836, 746), original)["kind"] == "allowed")
	assert(Routes.restriction_at(Vector2(-1, 100), original)["kind"] == "image")
	assert(not Routes.add_waypoint(original, Vector2(100, 100), "Previously blocked", "RM-ROOM-HALL").get("ok", false))
	assert(not Routes.add_zone_rectangle(original, "bad", Vector2(0, 0), Vector2(90, 90)).get("ok", false))
	assert(not Routes.add_zone_rectangle(original, "walkablePolygons", Vector2(100, 100), Vector2(102, 102)).get("ok", false))
	assert(not Routes.add_zone_rectangle(original, "walkablePolygons", Vector2(-1, 10), Vector2(30, 30)).get("ok", false))

	var painted := Routes.add_zone_rectangle(original, "walkablePolygons", Vector2(64, 64), Vector2(192, 192))
	assert(painted.get("ok", false), str(painted.get("error", "")))
	assert(painted["id"] == "QA-EDIT-WALK-001")
	assert(painted["document"]["walkablePolygons"].size() == 6)
	assert(original["walkablePolygons"].size() == 5, "Zone edits must be copy-on-write")
	assert(Routes.restriction_at(Vector2(100, 100), painted["document"])["kind"] == "allowed")
	var point := Routes.add_waypoint(painted["document"], Vector2(100, 100), "New Hall QA point", "RM-ROOM-HALL")
	assert(point.get("ok", false), str(point.get("error", "")))
	assert(point["document"]["waypoints"].size() == 23)
	assert(Routes.waypoint_room(point["document"]["waypoints"].back()) == "RM-ROOM-HALL")
	var denied_delete := Routes.delete_zone(point["document"], "walkablePolygons", "QA-EDIT-WALK-001")
	assert(not denied_delete.get("ok", false), "Cannot strand a waypoint by deleting its walkable area")
	var nogo_added := Routes.add_zone_rectangle(point["document"], "noGoPolygons", Vector2(130, 130), Vector2(160, 160))
	assert(nogo_added.get("ok", false), str(nogo_added.get("error", "")))
	assert(Routes.restriction_at(Vector2(140, 140), nogo_added["document"])["kind"] == "no-go")
	var gone := Routes.delete_zone(nogo_added["document"], "noGoPolygons", str(nogo_added["id"]))
	assert(gone.get("ok", false))
	assert(Routes.restriction_at(Vector2(140, 140), gone["document"])["kind"] == "allowed")
	var blocked := Routes.set_blocked(gone["document"], "F5", true)
	assert(blocked.get("ok", false), str(blocked.get("error", "")))
	assert(Routes.restriction_at(Vector2(176, 144), blocked["document"])["kind"] == "blocked-cell")
	assert(Routes.restriction_at(Vector2(100, 100), blocked["document"])["kind"] == "allowed")
	assert(Routes.save_draft(TEMP, blocked["document"]).get("ok", false))
	var persisted := Routes.load_draft(TEMP)
	assert(persisted.get("ok", false))
	assert(JSON.stringify(persisted["document"]) == JSON.stringify(JSON.parse_string(JSON.stringify(blocked["document"]))))
	var integrated := Adapter.load_source(Preview.USER, TEMP)
	assert(integrated.get("ok", false), str(integrated.get("error", "")))
	assert(integrated["waypointCount"] == 23 and integrated["routeCount"] == 19)
	assert(integrated["document"]["approval"] == "DRAFT_ONLY" and not integrated["document"]["productionReady"])

	# Test actual native controls and click/zone flow (headless layout regression).
	var view = View.new()
	root.add_child(view)
	view._set_document(original, false)
	var toolbar: Control = view.find_child("MainToolbar", true, false)
	assert(toolbar != null)
	assert(toolbar is HBoxContainer, "Toolbar must not be flow/auto-wrap squeezing captions vertically")
	assert(toolbar.get_combined_minimum_size().y < 65.0, "Toolbar must stay one compact row")
	assert(view.find_child("GridSettings", true, false) != null)
	assert(view.grid_width.is_inside_tree() and view.grid_visible.is_inside_tree())
	assert(view.inspector_scroll.vertical_scroll_mode == ScrollContainer.SCROLL_MODE_AUTO)
	assert(view.canvas.show_constraints)
	view.show_constraints_checkbox.set_pressed(false)
	assert(not view.canvas.show_constraints)
	view.show_constraints_checkbox.set_pressed(true)
	assert(view.canvas.show_constraints)
	view._show_restriction(Vector2(100, 100))
	assert(view.constraint_feedback.text.contains("Outside all GREEN WALKABLE"))
	view._show_restriction(Vector2(840, 580))
	assert(view.constraint_feedback.text.contains("QA-HALL-NOGO-TEA-TABLE"))
	view._begin_walkable_zone()
	assert(view.current_mode == "Zones")
	view._on_image_clicked(Vector2(64, 64))
	assert(view.zone_pending_corner == Vector2(64, 64))
	assert(view.canvas.zone_corner == Vector2(64, 64))
	var untouched := JSON.stringify(view.document)
	view._on_image_clicked(Vector2(192, 192))
	assert(view.document["walkablePolygons"].size() == 6)
	assert(view.zone_pending_group.is_empty() and not view.canvas.zone_corner.is_finite())
	assert(view.zone_ids.size() == 16)
	assert(view.dirty_label.text.contains("UNSAVED"))
	assert(view.history.size() > 0)
	var zone_count: int = int(view.document["walkablePolygons"].size())
	view._undo()
	assert(view.document["walkablePolygons"].size() == zone_count - 1)
	assert(JSON.stringify(view.document) == untouched)
	view._redo()
	assert(view.document["walkablePolygons"].size() == zone_count)
	assert(view.canvas.show_constraints)
	var index := -1
	for i in range(view.zone_ids.size()):
		if view.zone_ids[i]["id"] == "QA-EDIT-WALK-001":
			index = i
			break
	assert(index >= 0)
	view._on_zone_selected(index)
	assert(view.canvas.selected_zone == "QA-EDIT-WALK-001")
	view._delete_selected_zone()
	assert(view.document["walkablePolygons"].size() == 5)
	assert(view.document["approval"] == "DRAFT_ONLY")
	view.queue_free()
	assert(FileAccess.get_file_as_string(SOURCE) == source_before)
	assert(FileAccess.get_file_as_string(PROJECT) == project_before)
	assert(FileAccess.get_file_as_string(CANONICAL) == canonical_before)
	assert(DirAccess.remove_absolute(ProjectSettings.globalize_path(TEMP)) == OK)
	print("MAP-EDIT-03A layout and editable draft walkable/no-go zone smoke passed")
	quit()
