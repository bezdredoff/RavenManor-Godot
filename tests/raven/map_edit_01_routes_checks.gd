extends RefCounted
## MAP-EDIT-01: auto-executed by the existing Room Builder Godot CI smoke.
const Routes = preload("res://addons/room_builder_routes/route_document.gd")
const View = preload("res://addons/room_builder_routes/route_editor_view.gd")
const Canvas = preload("res://addons/room_builder_routes/route_canvas.gd")
const Plugin = preload("res://addons/room_builder_routes/plugin.gd")
const Graph = preload("res://scripts/raven/manor_navigation_graph.gd")


static func run(test_root: Window) -> void:
	var original_qa := FileAccess.get_file_as_string(Routes.HALL_SOURCE)
	var canonical := FileAccess.get_file_as_string("res://data/raven/manor_greybox_graph.json")
	assert(not original_qa.is_empty() and not canonical.is_empty())
	var imported := Routes.import_hall()
	assert(imported.ok, str(imported.get("error", "")))
	var doc: Dictionary = imported.document
	assert(doc.approval == "DRAFT_ONLY" and not doc.productionReady)
	assert(not doc.canonicalNavigationAuthority and doc.coordinateSpace == "image-pixel")
	assert(doc.waypoints.size() == 7 and doc.routes.size() == 7)
	for route in doc.routes:
		assert(route.provisional and route.cells.is_empty(), "Legacy edges stay provisional")
	var original_ids: Array = []
	for wp in doc.waypoints:
		original_ids.append(wp.id)
	assert(original_ids.has("QA-HALL-SPAWN"))
	assert(original_ids.has("QA-HALL-PORTAL-APPROACH"))
	assert(Routes.validate(doc).ok)
	assert(Routes._check_segment(Vector2(759, 719), Vector2(835, 570), doc) != "", "Provisional geometry crossing no-go must be rejected")

	# Column labels and deterministic grid with arbitrary pixel origin.
	assert(Routes.column_label(0) == "A")
	assert(Routes.column_label(7) == "H")
	assert(Routes.column_label(25) == "Z")
	assert(Routes.column_label(26) == "AA")
	assert(Routes.column_label(27) == "AB")
	assert(Routes.column_label(51) == "AZ")
	assert(Routes.column_label(52) == "BA")
	var address := Routes.parse_cell("h7")
	assert(address.ok and address.col == 7 and address.row == 6 and address.cell == "H7")
	assert(not Routes.parse_cell("A0").ok)
	assert(not Routes.parse_cell("A01").ok)
	assert(not Routes.parse_cell("2A").ok)
	assert(not Routes.parse_cell("AAA-1").ok)
	assert(Routes.cell_to_pixel("H7", doc) == Vector2(240, 208))
	var offset := Routes.change_grid(doc, 16, 24, Vector2(8, 12), true, true)
	assert(offset.ok, str(offset.get("error", "")))
	assert(Routes.cell_to_pixel("H7", offset.document) == Vector2(128, 168))
	assert(Routes.pixel_to_cell(Vector2(128, 168), offset.document) == "H7")
	assert(not Routes.cell_to_pixel("ZZ99", doc).is_finite())
	assert(Routes.pixel_to_cell(Vector2(1672, 40), doc).is_empty())
	assert(Routes.pixel_to_cell(Vector2(-1, 20), doc).is_empty())
	assert(not Routes.change_grid(doc, 0, 32, Vector2.ZERO, true, false).ok)

	# Edits are copy-on-write, preserving source and stable waypoint identities.
	var added := Routes.add_waypoint(doc, Vector2(840, 730), "Review position")
	assert(added.ok, str(added.get("error", "")))
	assert(added.id == "QA-USER-001")
	assert(doc.waypoints.size() == 7)
	var changed := Routes.move_waypoint(added.document, added.id, Vector2(846, 724))
	assert(changed.ok, str(changed.get("error", "")))
	var by_id := Routes._waypoint_lookup(changed.document)
	assert(by_id[added.id].pointPx == [846, 724])
	var renamed := Routes.set_waypoint_info(changed.document, added.id, "Evelyn staging", "Interaction")
	assert(renamed.ok)
	assert(Routes._waypoint_lookup(renamed.document)[added.id].label == "Evelyn staging")
	assert(not Routes.move_waypoint(renamed.document, added.id, Vector2(835, 570)).ok, "No-go polygon must reject waypoint")
	assert(not Routes.move_waypoint(renamed.document, added.id, Vector2(1800, 570)).ok)
	var second := Routes.add_waypoint(renamed.document, Vector2(844, 736))
	assert(second.ok and second.id == "QA-USER-002", "Stable IDs cannot be reallocated")
	var direction_base: Dictionary = doc.duplicate(true)
	direction_base.routes = []
	var route := Routes.add_route(direction_base, "QA-HALL-SPAWN", "QA-HALL-CENTRE")
	assert(route.ok)
	var route_id: String = route.id
	assert(route_id == "QA-ROUTE-008")
	var invalid := Routes.set_route_cells(route.document, route_id, "AA24 → AC24 → AA22")
	assert(not invalid.ok and str(invalid.error).contains("orthogonal"))
	assert(not Routes.parse_route_text("A1 → B2", doc).ok)
	var authored := Routes.set_route_cells(route.document, route_id, "AA24 → AA23 → AA22")
	assert(authored.ok, str(authored.get("error", "")))
	assert(not authored.document.routes[0].provisional)
	assert(authored.document.routes[0].cells == ["AA24", "AA23", "AA22"])
	var positions := Routes.route_points(authored.document.routes[0], authored.document)
	assert(positions.size() == 3 and positions[1] == Vector2(848, 720))
	var blocked := Routes.set_blocked(authored.document, "AA23", true)
	assert(not blocked.ok, "Obstacle can't cover an authored route")
	var outside := Routes.set_blocked(authored.document, "ZZ55", true)
	assert(not outside.ok, "Obstacle outside image")
	var block_free := Routes.set_blocked(authored.document, "AH24", true)
	assert(block_free.ok, str(block_free.get("error", "")))
	assert(block_free.document.blockedCells.has("AH24"))
	var unblocked := Routes.set_blocked(block_free.document, "AH24", false)
	assert(unblocked.ok and not unblocked.document.blockedCells.has("AH24"))

	# A directed cell route must compile to ordered intermediate QA anchors.
	var one_way := Routes.set_route_direction(authored.document, route_id, false)
	assert(one_way.ok)
	var compiled := Routes.compile_qa_graph(one_way.document)
	assert(compiled.ok and compiled.data.provenance.productionReady == false)
	assert(compiled.graph.anchors().size() == 8, "7 Hall points + one deterministic corner/cell anchor")
	assert(compiled.graph.route("QA-HALL-SPAWN", "QA-HALL-CENTRE").size() == 3)
	assert(compiled.graph.route("QA-HALL-CENTRE", "QA-HALL-SPAWN").is_empty(), "One way edge must not support reverse traversal")
	var both := Routes.set_route_direction(one_way.document, route_id, true)
	assert(both.ok)
	var back := Routes.route_preview(both.document, "QA-HALL-CENTRE", "QA-HALL-SPAWN")
	assert(back.ok and back.points.size() == 3 and back.lengthPx > 0)
	var reverse := Routes.route_preview(one_way.document, "QA-HALL-CENTRE", "QA-HALL-SPAWN")
	assert(not reverse.ok, "Unreachable destination fails closed")
	assert(not Routes.delete_waypoint(one_way.document, "QA-HALL-SPAWN").ok, "Dependency gate before delete")
	var route_removed := Routes.delete_route(one_way.document, route_id)
	assert(route_removed.ok)
	var point_removed := Routes.delete_waypoint(route_removed.document, "QA-HALL-SPAWN")
	assert(point_removed.ok)
	assert(not original_ids.is_empty() and doc.waypoints.size() == 7)

	# Round-trip, malformed draft and no production promotion.
	var temp := "user://room_builder_routes/test_map_edit_01_roundtrip.json"
	assert(Routes.save_draft(temp, both.document).ok)
	var loaded := Routes.load_draft(temp)
	assert(loaded.ok, str(loaded.get("error", "")))
	assert(JSON.stringify(loaded.document) == JSON.stringify(both.document))
	DirAccess.remove_absolute(ProjectSettings.globalize_path(temp))
	assert(not Routes.save_draft(Routes.HALL_SOURCE, doc).ok, "QA source is immutable")
	assert(not Routes.save_draft("res://data/raven/manor_greybox_graph.json", doc).ok)
	var forbidden: Dictionary = doc.duplicate(true)
	forbidden.productionReady = true
	assert(not Routes.validate(forbidden).ok)
	forbidden = doc.duplicate(true)
	forbidden.source.sha256 = "0"
	assert(not Routes.validate(forbidden).ok)
	assert(FileAccess.get_file_as_string(Routes.HALL_SOURCE) == original_qa)
	assert(FileAccess.get_file_as_string("res://data/raven/manor_greybox_graph.json") == canonical)
	var graph := Graph.new()
	graph.rebuild({})
	assert(graph.anchors().size() == 13)
	# Plugin and visual classes must parse and load under Godot without enabling gameplay.
	assert(View != null and Canvas != null and Plugin != null)
	# Exercise actual native view history controls with a real Control tree.
	var native_view = View.new()
	test_root.add_child(native_view)
	assert(native_view.document.get("kind") == "raven-grid-route-draft")
	var untouched := JSON.stringify(native_view.document)
	var extra := Routes.add_waypoint(native_view.document, Vector2(840, 730))
	assert(extra.ok)
	native_view._set_document(extra.document)
	assert(native_view.history.size() == 1)
	assert(native_view.dirty_label.text.contains("UNSAVED"))
	native_view._undo()
	assert(JSON.stringify(native_view.document) == untouched)
	native_view._redo()
	assert(JSON.stringify(native_view.document) == JSON.stringify(extra.document))
	native_view.queue_free()
	print("MAP-EDIT-01 native Room Builder route document smoke passed (grid, cells, geometry, one-way, persistence and immutable source).")
